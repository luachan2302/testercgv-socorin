{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the settings, welcome, editor, video, recorder, update, share and overlay windows. Only what the pages call from JavaScript is listed: files, the clipboard and the save dialog are handled by the app's own commands (src-tauri/src/commands.rs), and the plugins the Rust side calls directly need no entry here.",
  "windows": ["main", "welcome", "editor", "video", "recorder", "update", "share", "overlay-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-is-focused",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://socorin.com" }, { "url": "https://socorin.com/*" }]
    },
    "dialog:allow-open"
  ]
}
