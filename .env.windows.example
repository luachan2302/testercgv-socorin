# Windows code signing for scripts/build-windows.sh.
# Copy to .env.windows (git-ignored) once a certificate exists. Without this
# file the binaries are left unsigned and only their PE checksum is set.
WINDOWS_SIGN_PFX=/absolute/path/to/certificate.pfx
WINDOWS_SIGN_PASSWORD=
# Optional RFC 3161 timestamp server (scripts/windows-sign.sh default shown).
#WINDOWS_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
