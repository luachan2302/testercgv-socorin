# Updater signing for the build scripts (scripts/build-*.sh).
# The app only installs updates whose signature matches the public key in
# src-tauri/tauri.conf.json (plugins.updater.pubkey); the bundler makes that
# signature with this private key. Copy to .env.updater (git-ignored).
# Path to the key, or its contents (`tauri signer generate -w <path>`).
TAURI_SIGNING_PRIVATE_KEY=~/.tauri/socorin.key
# Empty when the key was generated without a password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
