# Copy this file to .env.apple (git-ignored) and fill it in.
# scripts/build-macos.sh loads it to sign and notarize the macOS installer.

# 1. Code signing: the "Developer ID Application" identity in your login
#    keychain (paid Apple Developer Program). List what you have with:
#      security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# 2. Notarization: pick ONE of the two methods.
#
# (a) App Store Connect API key.
#     App Store Connect -> Users and Access -> Integrations -> App Store Connect
#     API -> Team Keys -> Generate (role: Developer). Download the .p8 once and
#     keep it outside the repository.
APPLE_API_KEY=ABC123DEFG
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_API_KEY_PATH=~/.appstoreconnect/AuthKey_ABC123DEFG.p8

# (b) Apple ID + app-specific password, kept in the keychain by notarytool and
#     never in this file. Run once and type the app-specific password
#     (account.apple.com -> Sign-In and Security -> App-Specific Passwords)
#     at the prompt:
#       xcrun notarytool store-credentials screenshot-notary --apple-id you@example.com --team-id TEAMID1234
#     APPLE_ID / APPLE_PASSWORD are refused: the Tauri CLI would put that
#     password on the notarytool command line, where any local process can
#     read it.
#APPLE_KEYCHAIN_PROFILE=screenshot-notary
